model
  schema 1.1

type user
type organization
  relations
    define hr_manager: [user]
    define hr_access: hr_manager
    define employee: [department#employee]

type department
  relations
    define organization: [organization]
    define employee: [user]
    define hr_manager: [user]
    define hr_access: hr_manager or hr_access from organization

type employee_payment
  relations
    define employee: [user]
    define department: [department]
    define can_change: hr_access from department
    define can_view: employee or hr_access from department




